# ===========================================
# CONFIGURACIÓN DE ENTORNO - EJEMPLO
# ===========================================
# Copia este archivo como .env.local (desarrollo) o .env (producción)
# y completa con tus valores reales

# ----- ENTORNO -----
NODE_ENV=development
# Opciones: development | production

# ----- SERVIDOR -----
PORT=3000

# ----- BASE DE DATOS -----
# URL de conexión a PostgreSQL
# Formato: postgres://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL=postgres://usuario:password@localhost:5432/inventario_db

# Host de la base de datos (solo para referencia)
DB_HOST=localhost

# ----- AUTENTICACIÓN -----
# Secreto para firmar tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=tu_secreto_super_seguro_cambiar_en_produccion

# ----- CORS -----
# URLs permitidas para acceso CORS (separadas por comas si son múltiples)
# Ejemplo: http://localhost:5173,https://tu-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ----- EMAIL (Nodemailer) -----
# Configuración para envío de emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_o_app_password
EMAIL_FROM=noreply@tuempresa.com

# ----- UPLOADS -----
# Ruta para archivos subidos
UPLOAD_PATH=./src/public/uploads

# ----- OPTIONAL: LOGGING -----
# Nivel de logging: error | warn | info | debug
LOG_LEVEL=info

# ----- TWILIO SMS SERVICE -----
# Obtén estas credenciales en: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_PHONE_NUMBER=+57300123456

# Habilitar/deshabilitar envío real de SMS (true/false)
# En desarrollo, ponlo en 'false' para usar modo simulación
SMS_ENABLED=false

# ----- RECORDATORIOS -----
# Días por defecto para próximo mantenimiento
DEFAULT_MAINTENANCE_DAYS=90
